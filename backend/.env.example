# Environment Configuration
# Copy this file to .env and fill in your values

# Flask settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
HOST=0.0.0.0
PORT=5000
FLASK_ENV=development

# Database settings
DATABASE_TYPE=sqlite
# For SQLite (default):
DATABASE_URL=sqlite:///roadside_assistance.db
# For PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/roadside_assistance
# For MySQL:
# DATABASE_URL=mysql://username:password@localhost:3306/roadside_assistance

# OSRM service
# Use public demo server (limited) or your own OSRM instance
OSRM_BASE_URL=http://router.project-osrm.org
# For local OSRM:
# OSRM_BASE_URL=http://localhost:5000

# CORS settings (comma-separated origins)
CORS_ORIGINS=*

# API rate limiting
API_RATE_LIMIT=100 per hour

# Emergency detection settings
EMERGENCY_SCORE_THRESHOLD=70

# Misuse detection thresholds
MAX_REQUESTS_PER_10_MIN=5
MAX_CANCELS_PER_DAY=3

# Service status distance thresholds (meters)
DISTANCE_ASSIGNED=5000
DISTANCE_ON_THE_WAY=500
DISTANCE_ARRIVING=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# SMS notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email notifications (SendGrid)
SENDGRID_API_KEY=

# Geocoding (Google Maps)
GOOGLE_MAPS_API_KEY=

# Payment processing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
